<?xml version="1.0" encoding="utf-8"?>
<!-- As chaves de pareamento ficam só neste aparelho: nada vai para backup nem para outro celular. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
